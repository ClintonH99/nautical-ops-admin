let faqData = null;

async function loadFAQData() {
  if (!adminPassword) return;
  document.getElementById('faq-content').innerHTML = '<div class="loading-state"><div class="spinner"></div> Loading...</div>';
  try {
    const res = await fetch('/api/faq', { headers: { 'x-admin-password': adminPassword } });
    if (!res.ok) throw new Error('Failed');
    faqData = await res.json();
    renderFAQ();
  } catch(e) {
    document.getElementById('faq-content').innerHTML = '<div class="empty-state">Failed to load FAQ data</div>';
  }
}

function renderFAQ() {
  if (!faqData) return;
  const { faqs, questions } = faqData;

  const faqRows = faqs.map(f => `
    <tr>
      <td style="width:40px" class="mono">${f.display_order}</td>
      <td><strong>${f.question}</strong></td>
      <td style="max-width:300px;color:var(--text-muted);font-size:12px">${f.answer.substring(0,100)}...</td>
      <td>
        <button onclick="editFAQ('${f.id}','${encodeURIComponent(f.question)}','${encodeURIComponent(f.answer)}')" style="background:var(--navy-light);color:var(--navy);border:none;padding:4px 10px;border-radius:6px;font-size:12px;cursor:pointer">Edit</button>
      </td>
    </tr>`).join('');

  const qRows = questions.length ? questions.map(q => `
    <tr>
      <td><strong>${q.user_name||'—'}</strong><br><span class="mono" style="color:var(--text-muted);font-size:11px">${q.user_email||'—'}</span></td>
      <td>${q.question}</td>
      <td><span class="status-pill ${q.status==='pending'?'pill-trialing':'pill-active'}">${q.status}</span></td>
      <td class="mono" style="font-size:11px;color:var(--text-muted)">${fmtDate(q.created_at)}</td>
      <td>
        ${q.status==='pending'?`<button onclick="answerQuestion('${q.id}')" style="background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);padding:4px 10px;border-radius:6px;font-size:12px;cursor:pointer">Answer</button>`:'<span style="color:var(--text-muted);font-size:12px">Answered</span>'}
      </td>
    </tr>`).join('') : '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:24px">No questions submitted yet</td></tr>';

  document.getElementById('faq-content').innerHTML = `
    <div class="table-card" style="margin-bottom:24px">
      <div class="table-header">
        <div class="table-title">FAQs</div>
        <div style="display:flex;gap:8px;align-items:center">
          <span class="table-count">${faqs.length} total</span>
          <button onclick="addFAQ()" style="background:var(--navy);color:white;border:none;padding:6px 14px;border-radius:7px;font-size:12px;cursor:pointer;font-family:Inter,sans-serif">+ Add FAQ</button>
        </div>
      </div>
      <div style="overflow-x:auto"><table class="data-table"><thead><tr><th>#</th><th>Question</th><th>Answer Preview</th><th>Actions</th></tr></thead><tbody>${faqRows}</tbody></table></div>
    </div>
    <div class="table-card">
      <div class="table-header"><div class="table-title">User Submitted Questions</div><span class="table-count">${questions.length} total</span></div>
      <div style="overflow-x:auto"><table class="data-table"><thead><tr><th>User</th><th>Question</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead><tbody>${qRows}</tbody></table></div>
    </div>`;
}

function addFAQ() {
  const q = prompt('Question:');
  if (!q) return;
  const a = prompt('Answer:');
  if (!a) return;
  saveFAQ(null, q, a);
}

function editFAQ(id, q, a) {
  const newQ = prompt('Question:', decodeURIComponent(q));
  if (!newQ) return;
  const newA = prompt('Answer:', decodeURIComponent(a));
  if (!newA) return;
  saveFAQ(id, newQ, newA);
}

async function saveFAQ(id, question, answer) {
  try {
    const res = await fetch('/api/faq', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
      body: JSON.stringify({ id, question, answer })
    });
    if (!res.ok) throw new Error('Failed');
    await loadFAQData();
  } catch(e) {
    alert('Failed to save FAQ');
  }
}

async function answerQuestion(id) {
  const answer = prompt('Your answer to this question:');
  if (!answer) return;
  try {
    const res = await fetch('/api/faq', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-admin-password': adminPassword },
      body: JSON.stringify({ type: 'answer_question', id, answer })
    });
    if (!res.ok) throw new Error('Failed');
    await loadFAQData();
  } catch(e) {
    alert('Failed to save answer');
  }
}

