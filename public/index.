function loadExpenses(){try{return JSON.parse(localStorage.getItem('no_expenses')||'[]');}catch(e){return[];}}
function saveExpenses(e){localStorage.setItem('no_expenses',JSON.stringify(e));}
function monthlyEquivalent(a,p){if(p==='monthly')return a;if(p==='weekly')return a*52/12;if(p==='annual')return a/12;return 0;}
function periodLabel(p){return{monthly:'Monthly',weekly:'Weekly',annual:'Annual','once-off':'Once-off'}[p]||p;}
function renderAccounting(){
  var expenses=loadExpenses();
  var mrr=dashData.overview.mrr||0;
  var trialMrr=dashData.overview.trialMrr||0;
  var totalExp=expenses.reduce(function(s,e){return s+monthlyEquivalent(parseFloat(e.amount)||0,e.period);},0);
  var activeSubs=dashData.overview.activeSubscriptions||0;
  var paddleFee=Math.round(((mrr*0.05)+(activeSubs*0.50))*100)/100;
  var fourOceansDonation=Math.round(mrr*0.05*100)/100;
  var totalExpWithPaddle=totalExp+paddleFee;
  var totalExpWithAll=totalExpWithPaddle+fourOceansDonation;
  var oneOff=expenses.filter(function(e){return e.period==='once-off';}).reduce(function(s,e){return s+(parseFloat(e.amount)||0);},0);
  var net=mrr-totalExpWithAll;
  var rows=expenses.map(function(e,i){
    return '<tr><td><strong>'+e.name+'</strong></td><td class="mono">$'+parseFloat(e.amount).toFixed(2)+'</td><td><span class="status-pill '+(e.period==='once-off'?'pill-inactive':e.period==='annual'?'pill-trialing':'pill-active')+'">'+periodLabel(e.period)+'</span></td><td class="mono" style="color:var(--text-muted)">$'+monthlyEquivalent(parseFloat(e.amount)||0,e.period).toFixed(2)+'/mo</td><td><button onclick="editExpense('+i+')" style="background:none;border:1px solid var(--border);color:var(--text-muted);padding:3px 10px;border-radius:4px;cursor:pointer;font-size:12px;margin-right:4px">Edit</button><button onclick="deleteExpense('+i+')" style="background:none;border:1px solid #ef4444;color:#ef4444;padding:3px 10px;border-radius:4px;cursor:pointer;font-size:12px">Delete</button></td></tr>';
  }).join('');
  var footer=expenses.length>0?'<div style="padding:16px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:32px"><span style="font-size:13px;color:var(--text-muted)">Total Monthly Expenses: <strong style="color:var(--text)">$'+totalExpWithAll.toFixed(2)+'</strong></span><span style="font-size:13px;color:var(--text-muted)">Net Profit: <strong style="color:'+(net>=0?'var(--green)':'#ef4444')+'">'+(net>=0?'+':'-')+'$'+Math.abs(net).toFixed(2)+'/mo</strong></span></div>':'';
  document.getElementById('accounting-content').innerHTML=
    '<div class="stats-grid" style="margin-bottom:20px">'
    +'<div class="stat-card" style="--accent:var(--green)"><div class="stat-label">Total MRR</div><div class="stat-value">$'+mrr.toFixed(2)+'</div><span class="stat-delta neutral">+$'+trialMrr.toFixed(2)+' trial potential</span></div>'
    +'<div class="stat-card" style="--accent:#ef4444"><div class="stat-label">Monthly Expenses</div><div class="stat-value">$'+totalExpWithAll.toFixed(2)+'</div>'+(oneOff>0?'<span class="stat-delta neutral">+$'+oneOff.toFixed(2)+' once-off</span>':'')+'</div>'
    +'<div class="stat-card" style="--accent:'+(net>=0?'var(--navy)':'#ef4444')+'"><div class="stat-label">Net Monthly Profit</div><div class="stat-value" style="color:'+(net>=0?'var(--green)':'#ef4444')+'">'+(net>=0?'+':'-')+'$'+Math.abs(net).toFixed(2)+'</div><span class="stat-delta neutral">'+(mrr>0?((net/mrr)*100).toFixed(1):'0')+'% margin</span></div>'
    +'</div>'
    +'<div class="table-card" style="margin-bottom:20px"><div class="table-header"><div class="table-title">Add Expense</div></div>'
    +'<div style="padding:16px;display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">'
    +'<div style="display:flex;flex-direction:column;gap:4px;flex:2;min-width:160px"><label style="font-size:12px;color:var(--text-muted);font-weight:500">Expense Name</label><input id="exp-name" placeholder="e.g. Supabase Pro" style="padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-size:14px"/></div>'
    +'<div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:120px"><label style="font-size:12px;color:var(--text-muted);font-weight:500">Amount ($)</label><input id="exp-amount" type="number" min="0" step="0.01" placeholder="0.00" style="padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-size:14px"/></div>'
    +'<div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px"><label style="font-size:12px;color:var(--text-muted);font-weight:500">Payment Type</label><select id="exp-period" style="padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-size:14px"><option value="monthly">Monthly</option><option value="weekly">Weekly</option><option value="annual">Annual</option><option value="once-off">Once-off</option></select></div>'
    +'<button onclick="addExpense()" style="padding:8px 20px;background:var(--navy);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:14px;font-weight:500;height:38px">+ Add Expense</button>'
    +'</div></div>'
    +'<div class="table-card"><div class="table-header"><div class="table-title">Expenses</div><div class="table-count">'+expenses.length+' items</div></div>'
    +'<div style="overflow-x:auto"><table class="data-table"><thead><tr><th>Name</th><th>Amount</th><th>Type</th><th>Monthly Cost</th><th>Actions</th></tr></thead>'
    +'<tbody>'
    +'<tr style="background:rgba(14,165,233,0.05)"><td><strong>4Oceans Cleanup Donations</strong></td><td class="mono">$'+fourOceansDonation.toFixed(2)+'</td><td><span class="status-pill pill-active">Monthly</span></td><td class="mono" style="color:var(--text-muted)">$'+fourOceansDonation.toFixed(2)+'/mo</td><td style="color:#0ea5e9;font-size:12px">5% of MRR</td></tr>'
    +'<tr style="background:rgba(30,58,95,0.05)"><td><strong>Paddle Processing Fees</strong> <span style="font-size:11px;color:var(--text-mut)">(auto)</span></td><td class="mono">$'+paddleFee.toFixed(2)+'</td><td><span class="status-pill pill-active">Monthly</span></td><td class="mono" style="color:var(--text-muted)">$'+paddleFee.toFixed(2)+'/mo</td><td style="color:var(--text-muted);font-size:12px">5% + $0.50 × '+activeSubs+' subs</td></tr>'
    +(rows||'<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:32px">No manual expenses added yet.</td></tr>')
    +'</tbody></table></div>'
    +footer+'</div>';
}
function addExpense(){
  var name=document.getElementById('exp-name').value.trim();
  var amount=document.getElementById('exp-amount').value;
  var period=document.getElementById('exp-period').value;
  if(!name||!amount||parseFloat(amount)<=0){alert('Please enter a name and valid amount.');return;}
  var expenses=loadExpenses();
  expenses.push({name:name,amount:parseFloat(amount),period:period});
  saveExpenses(expenses);
  renderAccounting();
}
function deleteExpense(i){
  if(!confirm('Delete this expense?'))return;
  var expenses=loadExpenses();
  expenses.splice(i,1);
  saveExpenses(expenses);
  renderAccounting();
}
function editExpense(i){
  var expenses=loadExpenses();
  var e=expenses[i];
  var n=prompt('Expense name:',e.name);if(n===null)return;
  var a=prompt('Amount ($):',e.amount);if(a===null)return;
  var p=prompt('Payment type (monthly/weekly/annual/once-off):',e.period);if(p===null)return;
  if(['monthly','weekly','annual','once-off'].indexOf(p)===-1){alert('Invalid type.');return;}
  expenses[i]={name:n.trim(),amount:parseFloat(a),period:p};
  saveExpenses(expenses);
  renderAccounting();
}

function renderFourOceans(){
  var subs=dashData.subscriptions||[];
  var activeSubs=subs.filter(function(s){return s.status==='active'||s.status==='trialing';});
  var totalMrr=dashData.overview.mrr||0;
  var monthlyDonation=Math.round(totalMrr*0.05*100)/100;
  var now=new Date();
  var totalDonated=0;
  activeSubs.forEach(function(s){
    var start=new Date(s.created_at);
    var mrr=s.mrr||0;
    var monthsActive=(now.getFullYear()-start.getFullYear())*12+(now.getMonth()-start.getMonth());
    if(monthsActive<1)monthsActive=1;
    totalDonated+=mrr*0.05*monthsActive;
  });
  totalDonated=Math.round(totalDonated*100)/100;
  function monthsToEndOfYear(year){
    var endOfYear=new Date(year,11,31);
    var diff=(endOfYear-now)/1000/60/60/24/30.44;
    return Math.max(0,diff);
  }
  var currentYear=now.getFullYear();
  var forecasts=[];
  for(var y=currentYear;y<=currentYear+3;y++){
    var months=monthsToEndOfYear(y);
    var projected=totalDonated+(monthlyDonation*months);
    forecasts.push({year:y,projected:Math.round(projected*100)/100,monthly:monthlyDonation});
  }
  var planNames={'1_5':'1-5 Crew','6_10':'6-10 Crew','11_15':'11-15 Crew','16_25':'16-25 Crew','26_40':'26-40 Crew','40_plus':'40+ Crew'};
  var planBreakdown={};
  activeSubs.forEach(function(s){
    var tier=s.plan_tier||'unknown';
    if(!planBreakdown[tier])planBreakdown[tier]={count:0,mrr:0,donation:0};
    planBreakdown[tier].count++;
    planBreakdown[tier].mrr+=s.mrr||0;
    planBreakdown[tier].donation+=(s.mrr||0)*0.05;
  });
  var planRows=Object.keys(planBreakdown).map(function(tier){
    var p=planBreakdown[tier];
    return '<tr><td><strong>'+(planNames[tier]||tier)+'</strong></td><td class="mono">'+p.count+'</td><td class="mono" style="color:var(--green)">$'+p.mrr.toFixed(2)+'/mo</td><td class="mono" style="color:#0ea5e9">$'+p.donation.toFixed(2)+'/mo</td></tr>';
  }).join('');
  var forecastRows=forecasts.map(function(f){
    var isCurrent=f.year===currentYear;
    return '<tr'+(isCurrent?' style="background:rgba(14,165,233,0.06)"':'')+'><td><strong>'+f.year+(isCurrent?' <span style="font-size:11px;color:#0ea5e9">(current)</span>':'')+'</strong></td><td class="mono" style="color:#0ea5e9">$'+f.monthly.toFixed(2)+'/mo</td><td class="mono" style="color:var(--green);font-weight:600">$'+f.projected.toFixed(2)+'</td><td class="mono" style="color:var(--text-muted);font-size:12px">Based on '+activeSubs.length+' active subs</td></tr>';
  }).join('');
  document.getElementById('fouroceans-content').innerHTML=
    '<div class="stats-grid" style="margin-bottom:20px">'
    +'<div class="stat-card" style="--accent:#0ea5e9"><div class="stat-label">Total Donated to Date</div><div class="stat-value" style="color:#0ea5e9">$'+totalDonated.toFixed(2)+'</div><span class="stat-delta neutral">Estimated from subscription start dates</span></div>'
    +'<div class="stat-card" style="--accent:#0ea5e9"><div class="stat-label">Monthly Donation</div><div class="stat-value">$'+monthlyDonation.toFixed(2)+'</div><span class="stat-delta neutral">5% of $'+totalMrr.toFixed(2)+' MRR</span></div>'
    +'<div class="stat-card" style="--accent:var(--green)"><div class="stat-label">Projected This Year</div><div class="stat-value" style="color:var(--green)">$'+forecasts[0].projected.toFixed(2)+'</div><span class="stat-delta neutral">By Dec 31, '+currentYear+'</span></div>'
    +'<div class="stat-card" style="--accent:var(--navy)"><div class="stat-label">Active Subscriptions</div><div class="stat-value">'+activeSubs.length+'</div><span class="stat-delta neutral">Contributing to donations</span></div>'
    +'</div>'
    +'<div class="table-card" style="margin-bottom:20px"><div class="table-header"><div class="table-title">Donation Forecast by Year</div><div class="table-count">Based on current MRR</div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>Year</th><th>Monthly Rate</th><th>Projected Total by Dec 31</th><th>Notes</th></tr></thead><tbody>'+(forecastRows||'<tr><td colspan="4" style="text-align:center;color:var(--text-muted)">No active subscriptions</td></tr>')+'</tbody></table></div></div>'
    +'<div class="table-card"><div class="table-header"><div class="table-title">Breakdown by Plan</div><div class="table-count">'+activeSubs.length+' active</div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>Plan</th><th>Subscribers</th><th>MRR</th><th>Monthly Donation (5%)</th></tr></thead><tbody>'+(planRows||'<tr><td colspan="4" style="text-align:center;color:var(--text-muted)">No active subscriptions yet</td></tr>')+'</tbody></table></div></div>'
    +'<div style="margin-top:16px;padding:16px;background:rgba(14,165,233,0.06);border:1px solid rgba(14,165,233,0.2);border-radius:8px;font-size:13px;color:var(--text-muted)">💡 <strong style="color:var(--text)">Note:</strong> Donation amounts are estimates based on subscription MRR and start dates. Actual transfer amounts to 4Ocean will be confirmed on partnership terms are agreed.</div>';
}
</script>
