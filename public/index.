<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Nautical Ops — Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --navy:#1e3a5f;--navy-dark:#152d4a;--navy-light:#e8eef5;
    --bg:#f7f8fa;--white:#ffffff;--border:#e2e8f0;--border-dark:#cbd5e1;
    --text:#1e293b;--text-muted:#64748b;--text-light:#94a3b8;
    --green:#16a34a;--green-bg:#f0fdf4;--green-border:#bbf7d0;
    --red:#dc2626;--red-bg:#fef2f2;--amber:#d97706;--amber-bg:#fffbeb;
    --blue:#2563eb;--blue-bg:#eff6ff;--sidebar-w:224px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:14px;line-height:1.5;min-height:100vh;}
  #login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);}
  .login-box{width:380px;background:var(--white);border:1px solid var(--border);border-radius:16px;padding:40px;box-shadow:0 4px 24px rgba(0,0,0,0.06);}
  .login-logo{display:flex;align-items:center;gap:10px;margin-bottom:28px;}
  .logo-icon{width:40px;height:40px;background:var(--navy);border-radius:10px;display:flex;align-items:center;justify-content:center;}
  .logo-icon svg{width:22px;height:22px;}
  .login-brand{font-size:16px;font-weight:600;color:var(--navy);line-height:1.2;}
  .login-brand span{display:block;font-size:11px;font-weight:400;color:var(--text-muted);letter-spacing:0.05em;}
  .login-title{font-size:20px;font-weight:600;color:var(--text);margin-bottom:6px;}
  .login-sub{font-size:13px;color:var(--text-muted);margin-bottom:28px;}
  .login-label{font-size:12px;font-weight:500;color:var(--text);margin-bottom:6px;display:block;}
  .login-input{width:100%;background:var(--white);border:1px solid var(--border-dark);border-radius:8px;padding:10px 14px;color:var(--text);font-family:'IBM Plex Mono',monospace;font-size:14px;margin-bottom:16px;outline:none;transition:border-color 0.15s;}
  .login-input:focus{border-color:var(--navy);box-shadow:0 0 0 3px rgba(30,58,95,0.08);}
  .login-btn{width:100%;background:var(--navy);color:white;border:none;border-radius:8px;padding:11px;font-family:'Inter',sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:background 0.15s;}
  .login-btn:hover{background:var(--navy-dark);}
  .login-error{margin-top:12px;font-size:13px;color:var(--red);}
  #app{display:none;min-height:100vh;}
  .topbar{position:fixed;top:0;left:0;right:0;height:56px;background:var(--navy);display:flex;align-items:center;z-index:100;padding:0 20px;gap:0;box-shadow:0 1px 0 rgba(255,255,255,0.08);}
  .topbar-brand{display:flex;align-items:center;gap:9px;margin-right:24px;flex-shrink:0;}
  .topbar-logo{width:28px;height:28px;background:rgba(255,255,255,0.12);border-radius:7px;display:flex;align-items:center;justify-content:center;}
  .topbar-logo svg{width:16px;height:16px;}
  .topbar-brand-text{font-size:13px;font-weight:600;color:white;line-height:1.2;}
  .topbar-brand-text span{display:block;font-size:10px;font-weight:400;color:rgba(255,255,255,0.45);letter-spacing:0.08em;text-transform:uppercase;}
  .topbar-divider{width:1px;height:24px;background:rgba(255,255,255,0.12);margin-right:16px;flex-shrink:0;}
  .nav-tabs{display:flex;align-items:center;gap:2px;flex:1;overflow-x:auto;}
  .nav-tabs::-webkit-scrollbar{display:none;}
  .nav-item{display:flex;align-items:center;gap:6px;padding:6px 12px;border-radius:7px;cursor:pointer;font-size:13px;color:rgba(255,255,255,0.6);transition:all 0.12s;border:none;background:none;white-space:nowrap;flex-shrink:0;}
  .nav-item:hover{background:rgba(255,255,255,0.08);color:white;}
  .nav-item.active{background:rgba(255,255,255,0.14);color:white;}
  .nav-item .icon{font-size:13px;}
  .topbar-actions{display:flex;align-items:center;gap:8px;margin-left:auto;flex-shrink:0;}
  .refresh-btn{background:rgba(255,255,255,0.08);border:none;border-radius:7px;padding:6px 12px;color:rgba(255,255,255,0.7);font-size:12px;font-family:'Inter',sans-serif;cursor:pointer;display:flex;align-items:center;gap:5px;transition:background 0.12s;white-space:nowrap;}
  .refresh-btn:hover{background:rgba(255,255,255,0.14);color:white;}
  .logout-btn{background:none;border:none;padding:6px 10px;color:rgba(255,255,255,0.35);font-size:12px;cursor:pointer;font-family:'Inter',sans-serif;transition:color 0.12s;white-space:nowrap;}
  .logout-btn:hover{color:rgba(255,255,255,0.7);}
  .main{margin-left:0;padding:84px 32px 32px;min-height:100vh;}
  .page-header{margin-bottom:24px;}
  .page-title{font-size:20px;font-weight:600;color:var(--text);margin-bottom:2px;}
  .page-subtitle{font-size:13px;color:var(--text-muted);}
  .last-updated{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-light);margin-top:3px;}
  .section{display:none;}
  .section.active{display:block;}
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-bottom:24px;}
  .stat-card{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:18px 20px;border-top:3px solid var(--accent,var(--navy));}
  .stat-label{font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;}
  .stat-value{font-size:28px;font-weight:600;color:var(--text);line-height:1;margin-bottom:6px;}
  .stat-delta{font-size:12px;color:var(--green);font-weight:500;}
  .stat-delta.neutral{color:var(--text-muted);}
  .stat-delta.down{color:var(--red);}
  .stat-badge{display:inline-block;font-size:11px;font-weight:500;padding:2px 8px;border-radius:20px;}
  .badge-green{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border);}
  .badge-blue{background:var(--blue-bg);color:var(--blue);}
  .badge-amber{background:var(--amber-bg);color:var(--amber);}
  .badge-navy{background:var(--navy-light);color:var(--navy);}
  .chart-card{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:20px 24px;margin-bottom:24px;}
  .chart-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
  .chart-title{font-size:14px;font-weight:600;color:var(--text);}
  .chart-sub{font-size:12px;color:var(--text-muted);}
  .chart-bars{display:flex;align-items:flex-end;gap:5px;height:100px;}
  .chart-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;height:100%;justify-content:flex-end;}
  .chart-bar{width:100%;background:var(--navy-light);border-radius:4px 4px 0 0;min-height:3px;transition:background 0.15s;border:1px solid var(--border);border-bottom:none;}
  .chart-bar:hover{background:var(--navy);}
  .chart-bar-label{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--text-light);text-align:center;}
  .table-card{background:var(--white);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:24px;}
  .table-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
  .table-title{font-size:14px;font-weight:600;color:var(--text);}
  .table-count{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-muted);background:var(--bg);padding:3px 10px;border-radius:20px;border:1px solid var(--border);}
  .data-table{width:100%;border-collapse:collapse;}
  .data-table th{font-size:11px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-muted);padding:10px 20px;text-align:left;background:var(--bg);border-bottom:1px solid var(--border);}
  .data-table td{padding:12px 20px;font-size:13px;color:var(--text);border-bottom:1px solid var(--border);vertical-align:middle;}
  .data-table tr:last-child td{border-bottom:none;}
  .data-table tr:hover td{background:#fafbfc;}
  .mono{font-family:'IBM Plex Mono',monospace;font-size:12px;}
  .status-pill{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:500;padding:3px 8px;border-radius:20px;}
  .status-pill::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;}
  .pill-active{background:var(--green-bg);color:var(--green);}
  .pill-trialing{background:var(--blue-bg);color:var(--blue);}
  .pill-none{background:var(--bg);color:var(--text-muted);border:1px solid var(--border);}
  .pill-canceled{background:var(--red-bg);color:var(--red);}
  .pill-past_due{background:var(--amber-bg);color:var(--amber);}
  .loading-state{display:flex;align-items:center;justify-content:center;height:200px;color:var(--text-muted);font-size:13px;gap:10px;}
  .spinner{width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--navy);border-radius:50%;animation:spin 0.7s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;}
  .empty-state{padding:40px;text-align:center;color:var(--text-muted);font-size:13px;}
  @media(max-width:768px){
    .topbar{padding:0 12px;gap:0;}
    .topbar-brand-text span{display:none;}
    .main{padding:72px 16px 24px;}
    .two-col{grid-template-columns:1fr;}
    .stats-grid{grid-template-columns:1fr 1fr;}
    .logout-btn{display:none;}
    .nav-item span:not(.icon){display:none;}
    .nav-item{padding:6px 10px;}
  }
  @media(max-width:480px){
    .stats-grid{grid-template-columns:1fr 1fr;gap:8px;}
    .stat-card{padding:14px;}
    .stat-value{font-size:20px;}
    .data-table th,.data-table td{padding:8px 10px;font-size:11px;}
    .page-title{font-size:17px;}
    .chart-card{padding:14px;}
    .table-header{padding:12px 14px;flex-wrap:wrap;gap:6px;}
  }
</style>
</head>
<body>

<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 17.5Q4 20 12 20.5Q20 20 20 17.5L18.5 11H5.5Z" fill="none" stroke="white" stroke-width="1.4" stroke-linejoin="round"/>
          <rect x="7.5" y="7" width="9" height="5" rx="1" fill="none" stroke="white" stroke-width="1.4"/>
          <line x1="12" y1="3" x2="12" y2="7" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="12" cy="2.5" r="1.2" fill="white"/>
          <path d="M3 22 Q6 19.5 9 22 Q12 24.5 15 22 Q18 19.5 21 22" fill="none" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="login-brand">Nautical Ops<span>Admin Portal</span></div>
    </div>
    <div class="login-title">Welcome back</div>
    <div class="login-sub">Enter your password to access the dashboard</div>
    <label class="login-label">Password</label>
    <input type="password" id="password-input" class="login-input" placeholder="••••••••••••" autocomplete="current-password"/>
    <button class="login-btn" onclick="handleLogin()">Sign in to Dashboard</button>
    <div id="login-error" class="login-error"></div>
  </div>
</div>

<div id="app">
  <nav class="topbar">
    <div class="topbar-brand">
      <div class="topbar-logo">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 17.5Q4 20 12 20.5Q20 20 20 17.5L18.5 11H5.5Z" fill="none" stroke="white" stroke-width="1.4" stroke-linejoin="round"/>
          <rect x="7.5" y="7" width="9" height="5" rx="1" fill="none" stroke="white" stroke-width="1.4"/>
          <line x1="12" y1="3" x2="12" y2="7" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="12" cy="2.5" r="1.2" fill="white"/>
        </svg>
      </div>
      <div class="topbar-brand-text">Nautical Ops<span>Admin</span></div>
    </div>
    <div class="topbar-divider"></div>
    <div class="nav-tabs">
      <button class="nav-item active" onclick="showSection('overview',this)"><span class="icon">⚡</span><span>Dashboard</span></button>
      <button class="nav-item" onclick="showSection('vessels',this)"><span class="icon">⚓</span><span>Vessels</span></button>
      <button class="nav-item" onclick="showSection('users',this)"><span class="icon">👥</span><span>Users</span></button>
      <button class="nav-item" onclick="showSection('subscriptions',this)"><span class="icon">💳</span><span>Subscriptions</span></button>
      <button class="nav-item" onclick="showSection('activity',this)"><span class="icon">📊</span><span>Activity</span></button>
      <button class="nav-item" onclick="showSection('faq',this);loadFAQData()"><span class="icon">❓</span><span>FAQ</span></button>
      <button class="nav-item" onclick="showSection('accounting',this);renderAccounting()"><span class="icon">💰</span><span>Accounting</span></button>
      <button class="nav-item" onclick="showSection('fouroceans',this);renderFourOceans()"><span class="icon">🌊</span><span>4Oceans</span></button>
    </div>
    <div class="topbar-actions">
      <button class="refresh-btn" onclick="loadData()">↻ <span>Refresh</span></button>
      <button class="logout-btn" onclick="handleLogout()">Sign out</button>
    </div>
  </nav>

  <main class="main">
    <div id="section-overview" class="section active">
      <div class="page-header">
        <div class="page-title">Dashboard</div>
        <div class="page-subtitle">Live snapshot of Nautical Ops</div>
        <div class="last-updated" id="last-updated-overview"></div>
      </div>
      <div id="overview-content"><div class="loading-state"><div class="spinner"></div> Loading data...</div></div>
    </div>
    <div id="section-vessels" class="section">
      <div class="page-header"><div class="page-title">Vessels</div><div class="page-subtitle">All registered vessels and their status</div></div>
      <div id="vessels-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
    <div id="section-users" class="section">
      <div class="page-header"><div class="page-title">Users</div><div class="page-subtitle">All captains and crew members</div></div>
      <div id="users-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
    <div id="section-subscriptions" class="section">
      <div class="page-header"><div class="page-title">Subscriptions</div><div class="page-subtitle">All vessel subscription plans</div></div>
      <div id="subscriptions-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
    <div id="section-activity" class="section">
      <div class="page-header"><div class="page-title">Activity</div><div class="page-subtitle">App usage and data metrics</div></div>
      <div id="activity-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
    <div id="section-accounting" class="section">
      <div class="page-header"><div class="page-title">Accounting</div><div class="page-subtitle">Track expenses and calculate net profit</div></div>
      <div id="accounting-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
    <div id="section-fouroceans" class="section">
      <div class="page-header"><div class="page-title">🌊 4Oceans Donations</div><div class="page-subtitle">Track donations to 4Ocean Cleanup from Nautical Ops subscriptions</div></div>
      <div id="fouroceans-content"><div class="loading-state"><div class="spinner"iv> Loading...</div></div>
    </div>
    <div id="section-faq" class="section">
      <div class="page-header"><div class="page-title">FAQ & Support</div><div class="page-subtitle">Manage FAQs and view user submitted questions</div></div>
      <div id="faq-content"><div class="loading-state"><div class="spinner"></div> Loading...</div></div>
    </div>
  </main>
</div>

<script>
let dashData=null,adminPassword='';

function handleLogin(){
  const pw=document.getElementById('password-input').value.trim();
  if(!pw)return;
  adminPassword=pw;
  loadData(true);
}

document.getElementById('password-input').addEventListener('keydown',e=>{if(e.key==='Enter')handleLogin();});

function handleLogout(){
  adminPassword='';dashData=null;
  document.getElementById('login-screen').style.display='flex';
  document.getElementById('app').style.display='none';
  document.getElementById('password-input').value='';
  document.getElementById('login-error').textContent='';
}

async function loadData(isLogin=false){
  try{
    const res=await fetch('/api/data',{headers:{'x-admin-password':adminPassword}});
    if(res.status===401){document.getElementById('login-error').textContent='Incorrect password. Try again.';adminPassword='';return;}
    dashData=await res.json();
    if(isLogin){document.getElementById('login-screen').style.display='none';document.getElementById('app').style.display='block';}
    renderAll();
  }catch(err){document.getElementById('login-error').textContent='Connection error. Try again.';}
}

function renderAll(){
  renderOverview();renderVessels();renderUsers();renderSubscriptions();renderActivity();
  const t=new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
  document.getElementById('last-updated-overview').textContent='Updated at '+t;
}

const planLabel=p=>({'1_5':'1–5 Crew','6_10':'6–10 Crew','11_15':'11–15 Crew','16_25':'16–25 Crew','26_40':'26–40 Crew','40_plus':'40+ Crew'}[p]||p);
const billingLabel=b=>({monthly:'Monthly','3_months':'3 Months','6_months':'6 Months','12_months':'Yearly'}[b]||b);
const statusPill=s=>{const cls={active:'pill-active',trialing:'pill-trialing',canceled:'pill-canceled',past_due:'pill-past_due','no subscription':'pill-none'};return`<span class="status-pill ${cls[s]||'pill-none'}">${s}</span>`;};
const fmtDate=d=>d?new Date(d).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}):'—';
const fmtMoney=n=>'$'+n.toFixed(2);
const delta=(n,suffix='')=>n===0?`<span class="stat-delta neutral">No change this week</span>`:n>0?`<span class="stat-delta">+${n}${suffix} this week</span>`:`<span class="stat-delta down">${n}${suffix} this week</span>`;

function renderOverview(){
  const o=dashData.overview;
  document.getElementById('overview-content').innerHTML=`
    <div class="stats-grid">
      <div class="stat-card" style="--accent:var(--navy)"><div class="stat-label">Captains (HOD)</div><div class="stat-value">${o.totalCaptains}</div>${delta(o.newUsersLast7Days)}</div>
      <div class="stat-card" style="--accent:#64748b"><div class="stat-label">Crew Members</div><div class="stat-value">${o.totalCrew}</div><span class="stat-delta neutral">${o.totalUsers} total users</span></div>
      <div class="stat-card" style="--accent:var(--navy)"><div class="stat-label">Active Vessels</div><div class="stat-value">${o.totalVessels}</div>${delta(o.newVesselsLast7Days)}</div>
      <div class="stat-card" style="--accent:var(--green)"><div class="stat-label">Active Subscriptions</div><div class="stat-value">${o.activeSubscriptions}</div><span class="stat-badge badge-green">Paying</span></div>
      <div class="stat-card" style="--accent:var(--blue)"><div class="stat-label">Free Trials</div><div class="stat-value">${o.trialSubscriptions}</div><span class="stat-badge badge-blue">30-day trial</span></div>
      <div class="stat-card" style="--accent:var(--green)"><div class="stat-label">MRR (Active)</div><div class="stat-value" style="font-size:22px">${fmtMoney(o.mrr)}</div><span class="stat-delta">Pipeline: ${fmtMoney(o.trialMrr)}</span></div>
    </div>
    ${renderChart()}
    <div class="two-col">
      <div class="stat-card" style="--accent:var(--amber)"><div class="stat-label">Trips Logged</div><div class="stat-value">${o.totalTrips}</div><span class="stat-delta neutral">All time</span></div>
      <div class="stat-card" style="--accent:var(--amber)"><div class="stat-label">Maintenance Logs</div><div class="stat-value">${o.totalMaintenance}</div><span class="stat-delta neutral">All time</span></div>
    </div>`;
}

function renderChart(){
  const daily=dashData.dailySignups;
  const keys=Object.keys(daily).sort();
  const vals=keys.map(k=>daily[k]);
  const max=Math.max(...vals,1);
  const total=vals.reduce((a,b)=>a+b,0);
  const bars=keys.map((k,i)=>{
    const h=Math.max(3,Math.round((vals[i]/max)*90));
    return`<div class="chart-bar-wrap"><div class="chart-bar" style="height:${h}px" title="${k}: ${vals[i]}"></div><div class="chart-bar-label">${k.slice(5)}</div></div>`;
  }).join('');
  return`<div class="chart-card"><div class="chart-header"><div><div class="chart-title">Daily Signups — Last 14 Days</div><div class="chart-sub">${total} new users in this period</div></div></div><div class="chart-bars">${bars}</div></div>`;
}

function toggleVessel(i){
  const row=document.getElementById('vm-'+i);
  const arrow=document.getElementById('va-'+i);
  if(!row)return;
  const open=row.style.display==='none';
  row.style.display=open?'table-row':'none';
  if(arrow)arrow.textContent=open?'▾':'▸';
}

function renderVessels(){
  const vs=dashData.vessels;
  if(!vs.length){document.getElementById('vessels-content').innerHTML='<div class="table-card"><div class="empty-state">No vessels registered yet</div></div>';return;}
  const rows=vs.map((v,i)=>{
    const members=(v.members||[]).map(m=>`
      <tr style="background:#f8fafc">
        <td style="padding:8px 20px 8px 44px;font-size:12px;color:var(--text)">↳ ${m.name||'—'}</td>
        <td style="padding:8px 20px;font-size:11px" class="mono">${m.email||'—'}</td>
        <td style="padding:8px 20px"><span class="status-pill ${m.role==='HOD'?'pill-active':'pill-trialing'}">${m.role==='HOD'?'Captain':'Crew'}</span></td>
