{
  "version": 2,
  "builds": [
    {
      "src": "api/data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/expenses.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/faq.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sentry.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/updates.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/updates",
      "dest": "/api/updates.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/expenses",
      "dest": "/api/expenses.js"
    },
    {
      "src": "/api/faq",
      "dest": "/api/faq.js"
    },
    {
      "src": "/api/sentry",
      "dest": "/api/sentry.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
